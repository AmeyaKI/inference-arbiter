{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "inference-arbiter routing observability",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 10},
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (tier) (rate(requests_routed_total[1m]))",
          "legendFormat": "{{tier}}",
          "refId": "A"
        }
      ],
      "title": "Request Rate by Tier",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "short"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "right"}, "pieType": "pie", "tooltip": {"mode": "single"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (reason) (increase(routing_decision_total[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "title": "Routing Decisions by Reason (5m)",
      "type": "piechart"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]},
          "unit": "short",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8},
      "id": 3,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background", "graphMode": "area"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(increase(slo_breach_total[5m]))",
          "legendFormat": "SLO Breaches (5m)",
          "refId": "A"
        }
      ],
      "title": "SLO Breach Count (5m)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2}, {"color": "red", "value": 4}]},
          "unit": "short",
          "min": 0,
          "max": 8
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 8},
      "id": 4,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "displayMode": "gradient", "showUnfilled": true},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "endpoint_queue_depth",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "title": "Queue Depth per Endpoint",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 2}, {"color": "red", "value": 4}]},
          "unit": "short",
          "min": 0,
          "max": 8
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 8},
      "id": 5,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "displayMode": "gradient", "showUnfilled": true},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "endpoint_in_flight",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "title": "In-Flight Requests per Endpoint",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 10},
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 6,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.50, sum by (tier, le) (rate(request_latency_seconds_bucket[1m])))",
          "legendFormat": "p50 {{tier}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.95, sum by (tier, le) (rate(request_latency_seconds_bucket[1m])))",
          "legendFormat": "p95 {{tier}}",
          "refId": "B"
        }
      ],
      "title": "Latency P50 / P95 by Tier",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 10},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "id": 7,
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.50, sum by (complexity, le) (rate(classifier_confidence_bucket[1m])))",
          "legendFormat": "p50 confidence {{complexity}}",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "histogram_quantile(0.10, sum by (complexity, le) (rate(classifier_confidence_bucket[1m])))",
          "legendFormat": "p10 confidence {{complexity}}",
          "refId": "B"
        }
      ],
      "title": "Classifier Confidence by Label",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 20},
      "id": 8,
      "targets": [
        {
          "expr": "sum(rate(slo_met_total[5m])) / sum(rate(slo_evaluated_total[5m]))",
          "legendFormat": "SLO attainment",
          "refId": "A"
        }
      ],
      "title": "SLO Attainment Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 20},
      "id": 9,
      "targets": [
        {"expr": "bandit_policy_active", "legendFormat": "policy active", "refId": "A"},
        {"expr": "sum(bandit_observations_total)", "legendFormat": "observations", "refId": "B"}
      ],
      "title": "Bandit Convergence",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 20},
      "id": 10,
      "targets": [
        {"expr": "increase(batch_shed_total[5m])", "legendFormat": "batch shed", "refId": "A"},
        {"expr": "circuit_breaker_state", "legendFormat": "{{endpoint}}", "refId": "B"}
      ],
      "title": "Batch Shed / Circuit Breaker",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 26},
      "id": 11,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (tier, le) (rate(time_to_first_token_seconds_bucket[1m])))",
          "legendFormat": "TTFT p95 {{tier}}",
          "refId": "A"
        }
      ],
      "title": "Time to First Token P95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 26},
      "id": 12,
      "targets": [
        {"expr": "sum by (tier) (rate(cost_proxy_total[1m]))", "legendFormat": "{{tier}}", "refId": "A"}
      ],
      "title": "Cost Proxy Rate by Tier",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["inference", "routing", "llm"],
